<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">
    <Dialog
        id="shoppingItemDialog"
        title="{dialog>/title}"
        contentWidth="400px">
        <content>
            <form:SimpleForm editable="true" layout="ResponsiveGridLayout">
                <core:Label text="{i18n>name}" required="true" />
                <Input id="nameInput" value="{dialog>/name}" required="true" valueLiveUpdate="true" />
                <core:Label text="{i18n>quantity}" required="true" />
                <Input id="quantityInput" value="{dialog>/quantity}" required="true" type="Number" />
                <core:Label text="{i18n>unit}" required="true" />
                <Input id="unitInput" value="{dialog>/unit}" required="true" />
                <core:Label text="{i18n>category}" required="true" />
                <Input id="categoryInput" value="{dialog>/category}" required="true" />
            </form:SimpleForm>
        </content>
        <buttons>
            <Button text="{i18n>save}" press="onSaveItem" type="Emphasized" />
            <Button text="{i18n>cancel}" press="onCancelDialog" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
