{
  "_version": "1.84.0",
  "sap.app": {
    "id": "simpleshoppinglistui",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.23.0",
      "toolsId": "8be94af5-4db3-403d-9aba-01f9409a41ee"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/my/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.01"
        }
      },
      "shoppingService": {
        "uri": "/shopping/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.147.2",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "simpleshoppinglistui.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "shoppingModel": {
        "dataSource": "shoppingService",
        "type": "sap.ui.model.odata.v4.ODataModel",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "simpleshoppinglistui.view",
        "async": true,
        "viewPath": "simpleshoppinglistui.view"
      },
      "routes": [
        {
          "name": "RoutesimpleShoppingListUI",
          "pattern": ":?query:",
          "target": [
            "TargetsimpleShoppingListUI"
          ]
        },
        {
          "name": "ShoppingList",
          "pattern": "shopping",
          "target": [
            "ShoppingListTarget"
          ]
        }
      ],
      "targets": {
        "TargetsimpleShoppingListUI": {
          "id": "simpleShoppingListUI",
          "name": "simpleShoppingListUI"
        },
        "ShoppingListTarget": {
          "id": "ShoppingList",
          "name": "ShoppingList"
        }
      }
    },
    "rootView": {
      "viewName": "simpleshoppinglistui.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
