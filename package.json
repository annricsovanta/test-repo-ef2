{
  "name": "simple-shopping-list",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.6",
    "jest": "^30.4.1"
  },
  "scripts": {
    "start": "cds-serve",
    "start:local": "cds watch",
    "test": "jest",
    "deploy:local": "cds deploy --to sqlite:db.sqlite",
    "mbt:build": "mbt build --mtar simple-shopping-list.mtar",
    "cf:deploy": "cf deploy mta_archives/simple-shopping-list.mtar",
    "cf:login:dev": "cf l -a https://api.cf.eu10-004.hana.ondemand.com",
    "watch-simple-shopping-list-ui": "cds watch --open simpleshoppinglistui/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "cds": {
    "requires": {
      "[production]": {
        "auth": "xsuaa"
      },
      "destinations": true
    }
  },
  "overrides": {
    "@eslint/js": "^9"
  },
  "workspaces": [
    "app/*"
  ]
}
